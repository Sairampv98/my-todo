# Copy this file to .env (at the ROOT of the project) and fill in the values.

# --- Database ---------------------------------------------------------------
# Local MongoDB (default for development):
MONGO_URI=mongodb://127.0.0.1:27017/todo

# MongoDB Atlas (cloud) - replace with the SRV string from Atlas > Connect:
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo
#
# IMPORTANT: if your password contains @ : / # ? or %, URL-encode it, otherwise
# the driver cuts the string short and you get an authentication error.
#   @  -> %40    :  -> %3A    /  -> %2F    #  -> %23    %  -> %25

# --- DNS override (OPTIONAL) ------------------------------------------------
# Only needed on networks where Node's resolver cannot reach the real DNS.
# Symptom: "querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net"
# while the browser and PowerShell resolve the same name fine.
# Leave blank on a normal machine, on Render and on Netlify.
# DNS_SERVERS=8.8.8.8,202.88.156.6
